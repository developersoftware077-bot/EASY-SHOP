# Browser-safe values used by the storefront.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server values. SUPABASE_SERVICE_ROLE_KEY is server-only and is not required by
# the current storefront or sitemap. Never expose it in VITE_* variables.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used for canonical URLs, JSON-LD, sitemap.xml and robots.txt.
SITE_URL=
